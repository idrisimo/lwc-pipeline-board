<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Pipeline Board</masterLabel>
    <description>Drag-and-drop Opportunity pipeline Kanban board.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property
                name="maxCardsPerColumn"
                type="Integer"
                label="Max cards per column"
                default="50"
                min="1"
                max="200"
                description="Maximum number of cards rendered in each stage column."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
